     "showOrphans": false
    }
   ],
   "expected": {
    "nodes": [
     "a.md",
     "b.md"
    ],
    "edges": [
     [
      0,
      1,
      "link",
      1,
      false
     ]
    ],
    "hidden": {
     "orphans": 1,
     "outside": 0
    }
   }
  },
  {
