{
 "slug": "bases-link-graph",
 "module": "bases-link-graph/src/graph",
 "function": "buildGraph",
 "note": "buildGraph cases: args = [rows as [{id, label, links: {path: count}, props: {propertyId: value}}], options {showOrphans, linkEdges, sharedProps, maxGroup, focus, depth}]; expected = nodes as ids in order, edges as [source, target, kind, weight, mutual] for links and [source, target, kind, weight, prop, values] for shared values, and hidden {orphans, outside} when present. Cases with a \"function\" field call that export of the same module (sizeScale, colorScale, parseNumber) with args and compare the whole result. linkCounts counts resolved reference targets and filters property cache keys.",
 "cases": [
  {
   "name": "one link between two rows",
   "args": [
    [
     {
      "id": "a.md",
      "label": "a",
      "links": {
       "b.md": 1
      }
     },
     {
      "id": "b.md",
      "label": "b",
      "links": {}
     }
    ],
    {}
   ],
   "expected": {
    "nodes": [
     "a.md",
     "b.md"
    ],
    "edges": [
     [
      0,
      1,
      "link",
      1,
      false
     ]
    ],
    "hidden": {
     "orphans": 0,
     "outside": 0
    }
   }
  },
  {
   "name": "links both ways merge into one mutual edge",
   "args": [
    [
     {
      "id": "a.md",
      "label": "a",
      "links": {
       "b.md": 1
      }
     },
     {
      "id": "b.md",
      "label": "b",
      "links": {
       "a.md": 2
      }
     }
    ],
    {}
   ],
   "expected": {
    "nodes": [
     "a.md",
     "b.md"
    ],
    "edges": [
     [
      0,
      1,
      "link",
      3,
      true
     ]
    ]
   }
  },
  {
   "name": "links to notes outside the base and self links are ignored",
   "args": [
    [
     {
      "id": "a.md",
      "label": "a",
      "links": {
       "c.md": 4,
       "a.md": 1
      }
     },
     {
      "id": "b.md",
      "label": "b",
      "links": {}
     }
    ],
    {}
   ],
   "expected": {
    "nodes": [
     "a.md",
     "b.md"
    ],
    "edges": [],
    "hidden": {
     "orphans": 0,
     "outside": 0
    }
   }
  },
  {
   "name": "notes without links are hidden when showOrphans is false",
   "args": [
    [
     {
      "id": "a.md",
      "label": "a",
      "links": {
       "b.md": 1
      }
     },
     {
      "id": "b.md",
      "label": "b",
      "links": {}
